{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kompiluj caly projekt",
            "type": "process",
            "command": "g++",
            "windows": {
                "command": "C:\\MinGW\\bin\\g++.exe"
            },
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "-I",
                "${workspaceFolder}/include",
                "${workspaceFolder}/src/administrator.cpp",
                "${workspaceFolder}/src/klient.cpp",
                "${workspaceFolder}/src/konsola.cpp",
                "${workspaceFolder}/src/koszyk.cpp",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/platnosc.cpp",
                "${workspaceFolder}/src/pozycja_koszyka.cpp",
                "${workspaceFolder}/src/pozycja_zamowienia.cpp",
                "${workspaceFolder}/src/produkt.cpp",
                "${workspaceFolder}/src/system_sklepu.cpp",
                "${workspaceFolder}/src/uzytkownik.cpp",
                "${workspaceFolder}/src/zamowienie.cpp",
                "-o",
                "${workspaceFolder}/sklep"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Kompiluj testy",
            "type": "process",
            "command": "g++",
            "windows": {
                "command": "C:\\MinGW\\bin\\g++.exe"
            },
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "-I",
                "${workspaceFolder}/include",
                "${workspaceFolder}/src/administrator.cpp",
                "${workspaceFolder}/src/klient.cpp",
                "${workspaceFolder}/src/koszyk.cpp",
                "${workspaceFolder}/src/platnosc.cpp",
                "${workspaceFolder}/src/pozycja_koszyka.cpp",
                "${workspaceFolder}/src/pozycja_zamowienia.cpp",
                "${workspaceFolder}/src/produkt.cpp",
                "${workspaceFolder}/src/system_sklepu.cpp",
                "${workspaceFolder}/src/uzytkownik.cpp",
                "${workspaceFolder}/src/zamowienie.cpp",
                "${workspaceFolder}/tests/testy.cpp",
                "-o",
                "${workspaceFolder}/testy"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}
